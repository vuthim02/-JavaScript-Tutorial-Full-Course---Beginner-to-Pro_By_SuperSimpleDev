{
  "name": "full-api-server",
  "version": "1.0.0",
  "description": "Full REST API server with auth, rate limiting, database",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:s1": "node src/index.js",
