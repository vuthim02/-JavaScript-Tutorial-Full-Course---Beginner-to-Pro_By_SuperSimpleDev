# Required
TELEGRAM_BOT_TOKEN=

# Channel (set to @channel to enable auto-publishing)
TELEGRAM_CHANNEL_ID=

# --- Polling intervals ---
FAST_POLL_INTERVAL=2     # minutes: RSS/news check (1-5, default 2)
SLOW_POLL_INTERVAL=240   # minutes: API sources (default 240 = 4hr)
CRYPTO_POLL_INTERVAL=5   # minutes: crypto prices (0 to disable, default 5)

# --- AI Summarization ---
AI_PROVIDER=none          # openai, gemini, or none
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
TARGET_LANG=km            # en, km (Khmer), etc.
MAX_POSTS_PER_CYCLE=3     # max articles posted per cycle

# Dashboard
DASHBOARD_PORT=3000
